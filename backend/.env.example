# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Option A: Local PostgreSQL (default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=b2b_orders
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Option B: Full PostgreSQL Connection URL (e.g. Neon, Supabase, Render, or Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/b2b_orders?sslmode=disable

# Authentication Secrets
JWT_SECRET=b2b_jwt_super_secret_key_arrowstack_2026_production
JWT_EXPIRES_IN=24h

# Application Client URL
CLIENT_URL=http://localhost:5173
